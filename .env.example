# Create these values at https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_me

# Optional on the first login; use international format, e.g. +49123456789.
# If omitted, Telethon asks interactively.
TELEGRAM_PHONE=

# Comma-separated @usernames or numeric Telegram dialog IDs.
# Run `python -m telegram_voice_forwarder list-chats` to find numeric IDs.
TELEGRAM_SOURCE_CHATS=-1001234567890
TELEGRAM_TARGET_CHAT=-1009876543210

# Files below contain sensitive account/session information.
TELEGRAM_SESSION=data/telegram-monitor
STATE_DB=data/forwarder.sqlite3

# Maximum number of Telegram users, chats, and channels cached in memory.
# The reduced default saves memory. Values below 100 are rejected.
TELETHON_ENTITY_CACHE_LIMIT=500

# On the first start, inspect this many of the newest messages per source.
# Set to 0 to start monitoring from "now" without forwarding history.
INITIAL_SCAN_LIMIT=100

# Voice messages shorter than this duration (in seconds) are ignored.
# Decimals such as 2.5 are supported. Set to 0 to disable the filter.
MIN_VOICE_DURATION_SECONDS=0

# Also treat round video messages as voice messages.
INCLUDE_VIDEO_NOTES=false

# Bot publisher. Add the bot to TELEGRAM_TARGET_CHAT as an administrator
# with permission to post messages, then run setup-notification-bot.
TELEGRAM_NOTIFICATION_BOT_TOKEN=

LOG_LEVEL=INFO
